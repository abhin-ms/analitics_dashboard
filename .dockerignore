# Keep the build context small and secrets out of the image.
.git
.github
.claude
_scratch
docs
scripts
*.md
*.pdf
*.html
!frontend/index.html

# Secrets — supplied on the server at deploy time, never baked in
**/.env
**/.env.*
!**/.env.example
**/*service-account*.json
backend/bp-analytics-sync-*.json

# Local build output, caches, deps
**/node_modules
frontend/dist
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
backend/logs
backend/tests
