# ── Database ──
# Local XAMPP (no password):
DATABASE_URL=mysql+aiomysql://root@localhost:3306/bp_analytics
# Production:
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/bp_analytics

# ── Auth ──
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=90

# ── CORS (comma-separated origins) ──
# Include the backend's own host:port too (self-serves frontend/dist when
# it exists) or Socket.IO will reject connections opened from that address.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8001,http://localhost:8000,http://127.0.0.1:8000,http://0.0.0.0:8000

# ── Frontend ──
FRONTEND_URL=http://localhost:5173

# ── Instagram Bot ──
# Get from: https://developers.facebook.com > Your App > Settings > Basic
IG_APP_ID=
IG_APP_SECRET=
# Verify token must match what you enter in Facebook webhook config
IG_WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string
# Encryption key for access tokens stored in DB (any random string)
TOKEN_ENCRYPTION_KEY=change-me-to-a-random-key

# ── Meta Lead Ads (Facebook / Instagram lead forms → CRM) ──
# App secret: developers.facebook.com > leads store > App settings > Basic
META_APP_SECRET=
# Any random string; type the same value in Meta > Webhooks > Page > Verify token
META_VERIFY_TOKEN=
# System user token (Business settings > System users), never expires
META_ACCESS_TOKEN=
META_PAGE_ID=127389107129839
META_GRAPH_VERSION=v26.0

# ── Defaults ──
BASE_REPORTING_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
SMARTSERVICE_MCP_URL=https://smartserviceapitemp.azurewebsites.net/mcp

# ── SMTP (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
